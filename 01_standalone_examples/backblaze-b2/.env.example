# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored - never commit it, and never commit your license file.

# --- Backblaze B2 -----------------------------------------------------------
# Create an Application Key in the B2 console (Application Keys page).
# Do NOT use the Master Application Key: it is not supported by the S3-compatible API.
# If you scope the key to a single bucket, it also needs "listAllBucketNames".
B2_KEY_ID=
B2_APP_KEY=

# The region you chose when creating the account, e.g. us-west-004, us-east-005, eu-central-003.
# Your S3 endpoint is shown on the Buckets page as s3.<region>.backblazeb2.com
B2_REGION=
B2_BUCKET=

# --- lakeFS Enterprise license ----------------------------------------------
# Absolute path to your license file, kept OUTSIDE this repository.
LAKEFS_LICENSE_FILE=/path/to/your/license.token
LAKEFS_INSTALLATION_ID=
