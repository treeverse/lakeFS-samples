# ─────────────────────────────────────────────────────────────────────────────
# lakeFS Enterprise configuration template for the ONTAP demo.
# Copy this file to lakefs.yaml and fill in all REPLACE_ME values.
# lakefs.yaml is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

database:
  type: postgres
  postgres:
    connection_string: "postgresql://lakefs:lakefs@localhost:5432/lakefs?sslmode=disable"

auth:
  encrypt:
    # Must be >= 32 chars. Generate with: openssl rand -hex 20
    secret_key: "REPLACE_WITH_32_CHAR_RANDOM_STRING"
  ui_config:
    rbac: internal

installation:
  user_name: admin
  access_key_id: "AKIAIOSFODNN7EXAMPLE"
  secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

blockstore:
  type: s3
  s3:
    # The SVM management IP serving ONTAP S3. On FSx: console → Storage Virtual
    # Machines → fsx → Endpoints → Management IP address, or
    # `terraform output svm_management_ip`.
    # http:// is used here to avoid certificate handling in the demo; enable
    # HTTPS on the object-store server for any real deployment.
    endpoint: "http://REPLACE_ME_WITH_FSX_SVM_IP"

    # No pre_signed_endpoint is set: lakeFS signs URLs against the endpoint
    # above, which the EC2 host can reach directly. Only set one if you resolve
    # pre-signed URLs from somewhere that cannot reach the SVM address.

    # ONTAP S3 does not support virtual-hosted-style URLs.
    force_path_style: true

    # ONTAP S3 does not advertise AWS regions; any value works here.
    region: "us-east-1"

    credentials:
      # Generated by ONTAP CLI: vserver object-store-server user create -user lakefs
      access_key_id: "REPLACE_ME"
      secret_access_key: "REPLACE_ME"

server:
  listen_address: ":8000"

logging:
  level: "INFO"
  format: "text"

# lakeFS Enterprise license, provided by your Treeverse account team.
# license.token is gitignored — keep it that way.
license:
  path: /home/ubuntu/license.token

features:
  local_rbac: true
