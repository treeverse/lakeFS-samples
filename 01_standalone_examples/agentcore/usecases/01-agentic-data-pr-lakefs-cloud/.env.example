# =============================================================================
# Agentic Data PRs with Amazon Bedrock AgentCore and lakeFS Cloud
# -----------------------------------------------------------------------------
# Copy this file to `.env` (or run `make configure`) and fill in the values.
#
#   cp .env.example .env
#
# WARNING: `.env` holds sensitive credentials. It is gitignored and must NEVER
#          be committed. `make configure` writes it for you and never echoes
#          the lakeFS secret key.
#
# This sample connects to an EXISTING lakeFS Cloud installation. It does not
# deploy, configure, or modify lakeFS. Supply your endpoint and access keys,
# select an existing repository, and run the demo.
# =============================================================================

# --- lakeFS Cloud (required) -------------------------------------------------
# The base URL of your lakeFS Cloud installation, e.g. https://acme.us-east-1.lakefscloud.io
LAKEFS_ENDPOINT=
# lakeFS access key id (looks like AKIA... but is a lakeFS key, not an AWS key)
LAKEFS_ACCESS_KEY_ID=
# lakeFS secret access key. NEVER commit this and NEVER print it.
LAKEFS_SECRET_ACCESS_KEY=

# --- lakeFS repository selection (optional) ----------------------------------
# If set, the sample verifies this repository exists and uses it. If unset, the
# sample lists accessible repositories and selects/asks interactively.
LAKEFS_REPOSITORY=
# Source branch the disposable baseline is derived from. Defaults to `main`.
# The sample NEVER writes to this branch and verifies its HEAD is unchanged.
LAKEFS_SOURCE_BRANCH=main

# --- AWS / Amazon Bedrock AgentCore (required for deploy/run) ----------------
# Optional when the default AWS credential chain already resolves a profile.
AWS_PROFILE=
# Region hosting AgentCore Runtime, Gateway, Policy, Lambda and Secrets Manager.
AWS_REGION=us-west-2
# Bedrock model id the agent reasons with (an inference profile id is fine).
# Claude is recommended: it handles streaming tool use reliably. First-time
# Anthropic use requires a one-time use-case form (Bedrock Model catalog).
# List what your account can actually invoke with:
#   aws bedrock list-inference-profiles --query \
#     "inferenceProfileSummaries[?contains(inferenceProfileId,'anthropic')].inferenceProfileId"
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5
# Streaming tool use. Leave unset/true for Claude. Set false for Nova/Llama,
# which do not support tool use in streaming mode.
# AGENT_STREAMING=true
# Prefix applied to every AWS resource this sample creates:
#   <AGENTCORE_RESOURCE_PREFIX>-<run-id>
AGENTCORE_RESOURCE_PREFIX=agentcore-data-pr
